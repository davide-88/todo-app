{
  "name": "todo-app",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "dev": "pnpm --parallel -r dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint packages --max-warnings 0",
    "format": "prettier --write packages",
    "format:check": "prettier --check packages",
    "test": "pnpm --filter @todo-app/shared test:coverage && pnpm --filter !@todo-app/shared -r test",
    "test:coverage": "pnpm -r test:coverage",
    "test:integration": "pnpm --filter @todo-app/backend test:integration",
    "test:integration:ci": "pnpm --filter @todo-app/backend test:integration:ci",
    "test:e2e": "playwright test",
    "test:bundle-size": "bash scripts/check-bundle-size.sh",
    "test:api-latency": "tsx scripts/check-api-latency.ts",
    "test:lighthouse": "pnpm --filter @todo-app/frontend build && tsx scripts/check-lighthouse.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.58.2",
    "@types/node": "^24.1.0",
    "eslint": "^9.20.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "prettier": "^3.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.1"
  }
}
