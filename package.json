{
  "name": "todo-app",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel -r dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint packages --max-warnings 0",
    "format": "prettier --write packages",
    "test": "pnpm --filter @todo-app/shared test:coverage && pnpm --filter !@todo-app/shared -r test",
    "test:integration": "pnpm --filter @todo-app/backend test:integration",
    "test:e2e": "echo 'e2e tests not yet configured'"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "eslint": "^9.20.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "prettier": "^3.5.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.1"
  }
}
